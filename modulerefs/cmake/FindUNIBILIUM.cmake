      )

    message("UNIBILIUM_LIBRARY=${UNIBILIUM_LIBRARY}")
    message("UNIBILIUM_INCLUDE_DIR=${UNIBILIUM_INCLUDE_DIR}")

    include_directories("${UNIBILIUM_INCLUDE_DIR}")
