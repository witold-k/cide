if (NOT LIBUNISTRING_FOUND)
    set(LIBUNISTRING_INSTALL "${BB_TOP_DIR}/tmp/work/libunistring${BB_TARGET_PREFIX}-1.0-r0/install/${BB_TARGET}/${CMAKE_INSTALL_PREFIX}")

    set(LIBUNISTRING_LIBRARY      "${LIBUNISTRING_INSTALL}/lib/libunistring.so")
    set(LIBUNISTRING_LIBRARIES    "${LIBUNISTRING_INSTALL}/lib/libunistring.so")
    set(LIBUNISTRING_INCLUDE_DIR  "${LIBUNISTRING_INSTALL}/include")
    set(LIBUNISTRING_INCLUDE_DIRS "${LIBUNISTRING_INSTALL}/include")
    set(LIBUNISTRING_CFLAGS "-I${LIBUNISTRING_INCLUDE_DIR}")
    set(LIBUNISTRINGPATH "-I${LIBUNISTRING_INSTALL}/bin")
