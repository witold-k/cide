    )

    add_library(LIBSYSFS::LIBSYSFS SHARED IMPORTED)
    set_target_properties(LIBSYSFS::LIBSYSFS PROPERTIES
      IMPORTED_LOCATION   "${LIBSYSFS_LIBRARY}"
      INCLUDE_DIRECTORIES "${LIBSYSFS_INCLUDE_DIR}"
    )

    message("LIBSYSFS_LIBRARY=${LIBSYSFS_LIBRARY}")
    message("LIBSYSFS_INCLUDE_DIR=${LIBSYSFS_INCLUDE_DIR}")

    include_directories("${LIBSYSFS_INCLUDE_DIR}")
