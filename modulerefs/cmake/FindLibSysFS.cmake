if (NOT LIBSYSFS_FOUND)
    set(LIBSYSFS_INSTALL "${BB_TOP_DIR}/tmp/work/sysfsutils${BB_TARGET_PREFIX}-1.0-r0/install/${BB_TARGET}/${CMAKE_INSTALL_PREFIX}")

    set(LIBSYSFS_LIBRARY      "${LIBSYSFS_INSTALL}/lib/libsysfs.a")
    set(LIBSYSFS_LIBRARIES    "${LIBSYSFS_INSTALL}/lib/libsysfs.a")
    set(LIBSYSFS_INCLUDE_DIR  "${LIBSYSFS_INSTALL}/include")
    set(LIBSYSFS_INCLUDE_DIRS "${LIBSYSFS_INSTALL}/include")
    set(LIBSYSFS_CFLAGS "-I${LIBSYSFS_INCLUDE_DIR}")
    set(LIBSYSFSPATH "-I${LIBSYSFS_INSTALL}/bin")
