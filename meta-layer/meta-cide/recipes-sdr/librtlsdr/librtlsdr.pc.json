{
    "meta": {
        "Name": "RTL-SDR Library",
        "Description": "C Utility Library",
        "Version": "2.0.1"
    },

    "vars": {
        "prefix": "${PREFIX}",
        "exec_prefix": "${PREFIX}",
        "bindir": "${PREFIX}/bin",
        "libdir": "${PREFIX}/lib",
        "includedir": "${PREFIX}/include"
    },

    "build":  {
        "Libs": "-L${libdir} -lrtlsdr",
        "Cflags": "-I${includedir}",
        "Libs.private":  "-lusb-1.0"
    }
}

