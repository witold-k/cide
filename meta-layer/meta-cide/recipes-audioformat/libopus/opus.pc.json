{
    "meta": {
        "Name": "Opus",
        "Description": "Opus IETF audio codec (floating-point build)",
        "URL": "https://opus-codec.org/",
        "Version": "1.4-9-gc8549975"
    },

    "vars": {
        "prefix": "${PREFIX}",
        "exec_prefix": "${PREFIX}",
        "bindir": "${PREFIX}/bin",
        "libdir": "${PREFIX}/lib",
        "includedir": "${PREFIX}/include"
    },

    "build":  {
        "Libs": "-L${libdir} -lopus",
        "Libs.private": "-lm",
        "Cflags": "-I${includedir}/opus"
    }
}

