{
    "meta": {
        "Name": "vorbis",
        "Description": "vorbis is the primary Ogg Vorbis library",
        "Version": "1.3.7",
        "Requires.private": "ogg"
    },

    "vars": {
        "prefix": "${PREFIX}",
        "exec_prefix": "${PREFIX}",
        "bindir": "${PREFIX}/bin",
        "libdir": "${PREFIX}/lib",
        "includedir": "${PREFIX}/include"
    },

    "build":  {
        "Libs": "-L${libdir} -lvorbis",
        "Libs.private": "-lm",
        "Cflags": "-I${includedir}"
    }
}

