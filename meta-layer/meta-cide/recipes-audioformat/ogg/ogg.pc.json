{
    "meta": {
        "Name": "ogg",
        "Description": "ogg is a library for manipulating ogg bitstreams",
        "Version": "1.3.6"
    },

    "vars": {
        "prefix": "${PREFIX}",
        "exec_prefix": "${prefix}",
        "bindir": "${prefix}/bin",
        "libdir": "${prefix}/lib",
        "includedir": "${prefix}/include"
    },

    "build":  {
        "Libs": "-L${libdir} -logg",
        "Cflags": "-I${includedir}"
    }
}

