{
    "meta": {
        "Name": "FLAC",
        "Description": "Free Lossless Audio Codec Library",
        "Version": "1.4.3",
        "Requires.private": "ogg"
    },

    "vars": {
        "prefix": "${PREFIX}",
        "exec_prefix": "${PREFIX}",
        "bindir": "${PREFIX}/bin",
        "libdir": "${PREFIX}/lib",
        "includedir": "${PREFIX}/include"
    },

    "build":  {
        "Libs": "-L${libdir} -lFLAC",
        "Libs.private": "-lm",
        "Cflags": "-I${includedir}"
    }
}

