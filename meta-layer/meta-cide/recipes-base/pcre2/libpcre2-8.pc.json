{
    "meta": {
        "Name": "libpcre2-8",
        "Description": "PCRE2 - Perl compatible regular expressions C library (2nd API) with 8 bit character support",
        "Version": "10.44"
    },

    "vars": {
        "prefix": "${PREFIX}",
        "exec_prefix": "${PREFIX}",
        "bindir": "${PREFIX}/bin",
        "libdir": "${PREFIX}/lib",
        "includedir": "${PREFIX}/include"
    },

    "build":  {
        "Libs": "-L${libdir} -lpcre2-8 -pthread",
        "Cflags": "-I${includedir} -pthread"
    }
}

