{
    "meta": {
        "Name": "libpsl",
        "Description": "Public Suffix List C library",
        "Version": "0.21.5"
    },

    "vars": {
        "prefix": "${PREFIX}",
        "exec_prefix": "${PREFIX}",
        "bindir": "${PREFIX}/bin",
        "libdir": "${PREFIX}/lib",
        "includedir": "${PREFIX}/include"
    },

    "build":  {
        "Libs": "-L${libdir} -lpsl",
        "Cflags": "-I${includedir}"
    }
}

