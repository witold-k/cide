{
    "meta": {
        "Name": "libXML",
        "Version": "2.16",
        "Description": "libXML library version2."
    },

    "vars": {
        "prefix": "${PREFIX}",
        "exec_prefix": "${prefix}",
        "bindir": "${prefix}/bin",
        "libdir": "${prefix}/lib",
        "includedir": "${prefix}/include",
        "modules": "1"
    },

    "build":  {
        "Libs": "-L${libdir} -lxml2",
        "Libs.private": "-lm   -ldl",
        "Cflags": "-I${includedir}/libxml2"
    }
}

