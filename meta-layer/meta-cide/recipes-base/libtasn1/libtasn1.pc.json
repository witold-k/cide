{
    "meta": {
        "Name": "libtasn1",
        "Description": "Library for ASN.1 and DER manipulation",
        "URL": "https://www.gnu.org/software/libtasn1/",
        "Version": "4.19.0.65-0d539-dirty"
    },

    "vars": {
        "prefix": "${PREFIX}",
        "exec_prefix": "${PREFIX}",
        "bindir": "${PREFIX}/bin",
        "libdir": "${PREFIX}/lib",
        "includedir": "${PREFIX}/include"
    },

    "build":  {
        "Libs": "-L${libdir} -ltasn1",
        "Cflags": "-I${includedir}"
    }
}

