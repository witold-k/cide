{
    "meta": {
        "Name": "GThread",
        "Description": "Thread support for GLib",
        "Version": "2.83.2",
        "Requires": "glib-2.0"
    },

    "vars": {
        "prefix": "${PREFIX}",
        "exec_prefix": "${PREFIX}",
        "bindir": "${PREFIX}/bin",
        "libdir": "${PREFIX}/lib",
        "includedir": "${PREFIX}/include"
    },

    "build":  {
        "Libs": "-L${libdir} -lgthread-2.0 -pthread",
        "Cflags": "-I${includedir} -pthread"
    }
}

