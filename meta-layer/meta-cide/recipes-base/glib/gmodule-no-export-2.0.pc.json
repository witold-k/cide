{
    "meta": {
        "Name": "GModule",
        "Description": "Dynamic module loader for GLib",
        "Version": "2.83.2",
        "Requires": "glib-2.0"
    },

    "vars": {
        "prefix": "${PREFIX}",
        "exec_prefix": "${PREFIX}",
        "bindir": "${PREFIX}/bin",
        "libdir": "${PREFIX}/lib",
        "includedir": "${PREFIX}/include",
        "gmodule_supported": "true"
    },

    "build":  {
        "Libs": "-L${libdir} -lgmodule-2.0 -pthread",
        "Cflags": "-I${includedir} -pthread"
    }
}


