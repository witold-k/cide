{
    "meta": {
        "Name": "GObject",
        "Description": "GLib Type, Object, Parameter and Signal Library",
        "Version": "2.83.2",
        "Requires": "glib-2.0",
        "Requires.private": "libffi"
    },

    "vars": {
        "prefix": "${PREFIX}",
        "exec_prefix": "${PREFIX}",
        "bindir": "${PREFIX}/bin",
        "libdir": "${PREFIX}/lib",
        "includedir": "${PREFIX}/include"
    },

    "build":  {
        "Libs": "-L${libdir} -lgobject-2.0",
        "Cflags": "-I${includedir}"
    }
}

