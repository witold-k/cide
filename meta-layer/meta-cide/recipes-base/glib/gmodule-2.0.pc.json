{
    "meta": {
        "Name": "GModule",
        "Description": "Dynamic module loader for GLib",
        "Version": "2.83.2",
        "Requires": "gmodule-no-export-2.0, glib-2.0"
    },

    "vars": {
        "prefix": "${PREFIX}",
        "exec_prefix": "${PREFIX}",
        "bindir": "${PREFIX}/bin",
        "libdir": "${PREFIX}/lib",
        "includedir": "${PREFIX}/include",
        "gmodule_supported": "true"
    },

    "build":  {
        "Libs": "-Wl,--export-dynamic",
        "Cflags": "-I${includedir}"
    }
}

