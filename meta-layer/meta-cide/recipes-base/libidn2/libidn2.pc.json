{
    "meta": {
        "Name": "libidn2",
        "Description": "Library implementing IDNA2008 and TR46",
        "Version": "2.3.7.3-61ee-dirty"
    },

    "vars": {
        "prefix": "${PREFIX}",
        "exec_prefix": "${prefix}",
        "bindir": "${prefix}/bin",
        "libdir": "${prefix}/lib",
        "includedir": "${prefix}/include"
    },

    "build":  {
        "Libs": "-L${libdir} -lidn2",
        "Libs.private": "-L${PREFIX.UNISTRING} -lunistring -R${PREFIX.UNISTRING}",
        "Cflags": "-I${includedir}"
    }
}

