{
    "meta": {
        "Name": "Readline",
        "Description": "Gnu Readline library for command line editing",
        "URL": "http://tiswww.cwru.edu/php/chet/readline/rltop.html",
        "Version": "8.2",
        "Requires.private": "termcap"
    },

    "vars": {
        "prefix": "${PREFIX}",
        "exec_prefix": "${PREFIX}",
        "bindir": "${PREFIX}/bin",
        "libdir": "${PREFIX}/lib",
        "includedir": "${PREFIX}/include"
    },

    "build":  {
        "Libs": "-L${libdir} -lreadline",
        "Cflags": "-I${includedir}"
    }
}

