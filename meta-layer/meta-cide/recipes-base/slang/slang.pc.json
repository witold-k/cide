{
    "meta": {
        "Name": "slang",
        "Description": "S-Lang programming library and interpreter",
        "URL": "http://www.jedsoft.org/slang/",
        "Version": "2.3.4"
    },

    "vars": {
        "prefix": "${PREFIX}",
        "exec_prefix": "${PREFIX}",
        "bindir": "${PREFIX}/bin",
        "libdir": "${PREFIX}/lib",
        "includedir": "${PREFIX}/include"
    },

    "build":  {
        "Libs": "-L${libdir} -lslang",
        "Libs.private": "-ldl  -lm",
        "Cflags": "-I${includedir}"
    }
}

