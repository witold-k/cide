{
    "meta": {
        "Name": "libiio",
        "Description": "Library for interfacing IIO devices",
        "Version": "1.0"

    },

    "vars": {
        "prefix": "${PREFIX}",
        "exec_prefix": "${PREFIX}",
        "bindir": "${PREFIX}/bin",
        "libdir": "${PREFIX}/lib",
        "includedir": "${PREFIX}/include"
    },

    "build":  {
        "Libs": "-L${libdir} -liio",
        "Cflags": "-I${includedir}"
    }
}

