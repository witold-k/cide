{
    "meta": {
        "Name": "Clipper2z",
        "Description": "A Polygon Clipping and Offsetting library in C++",
        "Version": "1.4.0",
        "URL": "https://github.com/AngusJohnson/Clipper2"
    },

    "vars": {
        "prefix": "${PREFIX}",
        "exec_prefix": "${PREFIX}",
        "bindir": "${PREFIX}/bin",
        "libdir": "${PREFIX}/lib",
        "includedir": "${PREFIX}/include"
    },

    "build":  {
        "Libs": "-L${libdir} -lClipper2z",
        "Cflags": "-I${includedir}"
    }
}

