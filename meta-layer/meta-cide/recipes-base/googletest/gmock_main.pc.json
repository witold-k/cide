{
    "meta": {
        "Name": "gmock_main",
        "Description": "GoogleMock (with main() function)",
        "Version": "1.15.2",
        "URL": "https://github.com/google/googletest",
        "Requires": "gmock = 1.15.2"
    },

    "vars": {
        "prefix": "${PREFIX}",
        "exec_prefix": "${PREFIX}",
        "bindir": "${PREFIX}/bin",
        "libdir": "${PREFIX}/lib",
        "includedir": "${PREFIX}/include"
    },

    "build":  {
        "Libs": "-L${libdir} -lgmock_main",
        "Cflags": "-I${includedir} -DGTEST_HAS_PTHREAD=1"
    }
}

