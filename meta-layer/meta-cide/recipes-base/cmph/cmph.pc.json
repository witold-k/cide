{
    "meta": {
        "Name": "cmph",
        "Description": "minimal perfect hashing library",
        "Version": "2.0.2",
        "URL": "${url}"
    },

    "vars": {
        "url": "http://cmph.sourceforge.net/",
        "prefix": "${PREFIX}",
        "exec_prefix": "${PREFIX}",
        "bindir": "${PREFIX}/bin",
        "libdir": "${PREFIX}/lib",
        "includedir": "${PREFIX}/include"
    },

    "build":  {
        "Libs": "-L${libdir} -lcmph",
        "Cflags": "-I${includedir}"
    }
}

