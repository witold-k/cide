{
    "meta": {
        "Name": "alsa",
        "Description": "Advanced Linux Sound Architecture (ALSA) - Library",
        "Version": "1.2.14"
    },

    "vars": {
        "prefix": "${PREFIX}",
        "exec_prefix": "${PREFIX}",
        "libdir": "${PREFIX}/lib",
        "includedir": "${PREFIX}/include"
    },

    "build": {
        "Libs": "-L${libdir} -lasound",
        "Libs.private": "-lm -lpthread -lrt",
        "Cflags": "-I${includedir}"
    }
}

