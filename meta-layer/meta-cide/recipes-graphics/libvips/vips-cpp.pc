prefix=${PREFIX}
includedir=${prefix}/include
libdir=${prefix}/lib

Name: vips-cpp
Description: C++ API for vips8 image processing library
Version: 8.19.0
Requires: vips, glib-2.0 >= 2.52, gobject-2.0
Requires.private: gio-2.0, gmodule-no-export-2.0, expat, zlib >= 0.4, libjpeg, libuhdr, libpng >= 1.2.9, libtiff-4
Libs: -L${libdir} -lvips-cpp
Libs.private: -pthread -lm
Cflags: -I${includedir}
