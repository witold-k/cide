prefix=${PREFIX}
includedir=${prefix}/include
libdir=${prefix}/lib

Name: vips
Description: Image processing library
Version: 8.19.0
Requires: glib-2.0 >= 2.52, gio-2.0, gobject-2.0
Requires.private: gmodule-no-export-2.0, expat, zlib >= 0.4, libjpeg, libuhdr, libpng >= 1.2.9, libtiff-4
Libs: -L${libdir} -lvips
Libs.private: -pthread -lm
Cflags: -I${includedir}
