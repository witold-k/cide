prefix=${PREFIX}
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include

Name: cairo
Description:8Multi-platform 2D graphics library
Version: 1.18.1

Requires.private:   gobject-2.0 glib-2.0 >= 2.14      pixman-1 >= 0.30.0    fontconfig >= 2.2.95 freetype2 >= 9.7.3   libpng 
Libs: -L${libdir} -lcairo -lpixman-1 -lexpat -lxml2 -lz
Libs.private:           -lz -lz     
Cflags: -I${includedir}/cairo
