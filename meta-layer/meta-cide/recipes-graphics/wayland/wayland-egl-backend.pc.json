{
    "meta": {
        "Name": "wayland-egl-backend",
        "Description": "Backend wayland-egl interface",
        "Version": "3"
    },

    "vars": {
        "prefix": "${PREFIX}",
        "exec_prefix": "${PREFIX}",
        "bindir": "${PREFIX}/bin",
        "libdir": "${PREFIX}/lib",
        "includedir": "${PREFIX}/include"
    },

    "build":  {
        "Cflags": "-I${includedir}"
    }
}

