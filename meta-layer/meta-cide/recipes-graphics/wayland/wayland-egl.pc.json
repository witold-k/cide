{
    "meta": {
        "Name": "wayland-egl",
        "Description": "Frontend wayland-egl library",
        "Version": "18.1.0",
        "Requires": "wayland-client"
    },

    "vars": {
        "prefix": "${PREFIX}",
        "exec_prefix": "${PREFIX}",
        "bindir": "${PREFIX}/bin",
        "libdir": "${PREFIX}/lib",
        "includedir": "${PREFIX}/include"
    },

    "build":  {
        "Libs": "-L${libdir} -lwayland-egl",
        "Libs.private": "-lm -pthread -lrt",
        "Cflags": "-I${includedir}"
    }
}

