{
    "meta": {
        "Name": "zstd",
        "Description": "fast lossless compression algorithm library",
        "URL": "https://facebook.github.io/zstd/",
        "Version": "1.5.7"
    },

    "vars": {
        "prefix": "${PREFIX}",
        "exec_prefix": "${PREFIX}",
        "bindir": "${PREFIX}/bin",
        "libdir": "${PREFIX}/lib",
        "includedir": "${PREFIX}/include"
    },

    "build":  {
        "Libs": "-L${libdir} -lzstd",
        "Libs.private": "-pthread",
        "Cflags": "-I${includedir}"
    }
}

