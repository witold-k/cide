{
    "meta": {
        "Name": "bzip2",
        "Description": "Lossless, block-sorting data compression",
        "Version": "1.1.0"
    },

    "vars": {
        "prefix": "${PREFIX}",
        "exec_prefix": "${PREFIX}",
        "bindir": "${PREFIX}/bin",
        "libdir": "${PREFIX}/lib",
        "includedir": "${PREFIX}/include"
    },

    "build":  {
        "Libs": "-L${libdir} -lbz2",
        "Cflags": "-I${includedir}"
    }
}

