{
    "meta": {
        "Name": "liblzma",
        "Description": "General purpose data compression library",
        "URL": "https://tukaani.org/xz/",
        "Version": "5.6.3"
    },

    "vars": {
        "prefix": "${PREFIX}",
        "exec_prefix": "${PREFIX}",
        "bindir": "${PREFIX}/bin",
        "libdir": "${PREFIX}/lib",
        "includedir": "${PREFIX}/include"
    },

    "build":  {
        "Libs": "-L${libdir} -llzma",
        "Cflags.private": "-DLZMA_API_STATIC",
        "Cflags": "-I${includedir}"
    }
}

