{
    "meta": {
        "Name": "leptonica",
        "Description": "image processing",
        "Version": "1.88.0",
        "Requires.private": "zlib"
    },

    "vars": {
        "prefix": "${PREFIX}",
        "exec_prefix": "${prefix}",
        "bindir": "${prefix}/bin",
        "libdir": "${prefix}/lib",
        "includedir": "${prefix}/include"
    },

    "build":  {
        "Libs": "-L${libdir} -lleptonica -lm",
        "Libs.private": "-L${PREFIX.LIBZ} -lleptonica -lm",
        "Cflags": "-I${includedir}"
    }
}

