{
    "meta": {
        "Name": "libuhdr",
        "Description": "Library for encoding and decoding ultrahdr images",
        "Version": "1.4.0",
        "Requires.private": "libjpeg"
    },

    "vars": {
        "prefix": "${PREFIX}",
        "libdir": "${prefix}/lib",
        "includedir": "${prefix}/include"
    },

    "build":  {
        "Libs": "-L${libdir} -luhdr",
        "Cflags": "-I${includedir}"
    }
}

