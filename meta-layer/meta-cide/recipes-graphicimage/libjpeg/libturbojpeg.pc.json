{
    "meta": {
        "Name": "libjpeg",
        "Description": "A SIMD-accelerated JPEG codec that provides the TurboJPEG API",
        "Version": "3.0.3"
    },

    "vars": {
        "prefix": "${PREFIX}",
        "exec_prefix": "${prefix}",
        "bindir": "${prefix}/bin",
        "libdir": "${prefix}/lib",
        "includedir": "${prefix}/include"
    },

    "build":  {
        "Libs": "-L${libdir} -lturbojpeg",
        "Cflags": "-I${includedir}"
    }
}

