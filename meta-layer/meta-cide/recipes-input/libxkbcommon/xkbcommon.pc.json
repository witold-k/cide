{
    "meta": {
        "Name": "xkbcommon",
        "Description": "XKB API common to servers and clients",
        "Version": "1.8.0"
    },

    "vars": {
        "prefix": "${PREFIX}",
        "exec_prefix": "${PREFIX}",
        "bindir": "${PREFIX}/bin",
        "libdir": "${PREFIX}/lib",
        "includedir": "${PREFIX}/include"
    },

    "build":  {
        "Libs": "-L${libdir} -lxkbcommon",
        "Cflags": "-I${includedir}"
    }
}

