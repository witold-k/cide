{
    "meta": {
        "Name": "OpenSSL-libssl",
        "Description": "Secure Sockets Layer and cryptography libraries",
        "Version": "3.6.0-dev"
    },

    "vars": {
        "prefix": "${PREFIX}",
        "exec_prefix": "${PREFIX}",
        "libdir": "${PREFIX}/lib",
        "includedir": "${PREFIX}/include"
    },

    "build":  {
        "Libs": "-L${libdir} -lssl",
        "Cflags": "-I${prefix}/include"
    }
}

