{
    "meta": {
        "Name": "GNU MP",
        "Description": "GNU Multiple Precision Arithmetic Library",
        "URL": "https://gmplib.org",
        "Version": "6.2.1"
    },

    "vars": {
        "prefix": "${PREFIX}",
        "exec_prefix": "${PREFIX}",
        "libdir": "${PREFIX}/lib",
        "includedir": "${PREFIX}/include"
    },

    "build":  {
        "Libs": "-L${libdir} -lgmp",
        "Cflags": "-I${includedir}"
    }
}

