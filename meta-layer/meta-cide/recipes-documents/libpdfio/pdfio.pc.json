{
    "meta": {
        "Name": "pdfio",
        "Version": "1.6.0",
        "Description": "PDF read/write library",
        "URL": "https://www.msweet.org/pdfio"
    },

    "vars": {
        "prefix": "${PREFIX}",
        "exec_prefix": "${prefix}",
        "bindir": "${prefix}/bin",
        "libdir": "${prefix}/lib",
        "includedir": "${prefix}/include",
        "modules": "1"
    },

    "build":  {
        "Libs": "-L${libdir} -lpdfio -lz -lm"
    }
}

